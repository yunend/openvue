{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openvue",
  "version": "1.1.0",
  "identifier": "com.administrator.openvue",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run build:web && npm run dev",
    "beforeBuildCommand": "npm run build:all"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenVue",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "config.json",
      "plugins.json",
      "dist-web/**/*",
      "public/**/*"
    ],
    
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}