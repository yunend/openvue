{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openvue",
  "version": "0.2.0",
  "identifier": "com.administrator.openvue",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenVue",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets":  ["nsis"],
    "resources": [
      "config.json",
      "plugins.json",
      "static/**/*",
      "public/**/*"
    ],
    
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}